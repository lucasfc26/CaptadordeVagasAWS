# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://jobwatch:jobwatch@localhost:5432/jobwatch?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# WhatsApp (Cloud API — token permanente + Phone Number ID do painel Meta)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_BODY_PARAMS=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JobWatch <no-reply@jobwatch.com>"

# CORS
CORS_ORIGIN=http://localhost:5173

# Monitoring
JOB_SOURCE=amazon
MONITORING_CONCURRENCY=3
WAREHOUSE_EXTRACTOR_URL=http://localhost:8100
