# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://jobwatch:jobwatch@localhost:5432/jobwatch?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JobWatch <no-reply@jobwatch.com>"

# CORS
CORS_ORIGIN=http://localhost:5173

# Monitoring
JOB_SOURCE=amazon
MONITORING_CONCURRENCY=3
