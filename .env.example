# Used by docker-compose.yml when running the full stack with `docker compose up`.
# Copy to `.env` in this same folder and adjust before deploying anywhere real.

# PostgreSQL
POSTGRES_DB=jobwatch
POSTGRES_USER=jobwatch
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# Frontend
CORS_ORIGIN=http://localhost:5173

# Monitoring
JOB_SOURCE=amazon
MONITORING_CONCURRENCY=3
WAREHOUSE_EXTRACTOR_URL=http://warehouse-extractor:8100

# WhatsApp (Cloud API — token permanente + Phone Number ID do painel Meta)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Parâmetros do corpo do template, se não for hello_world: title,message,url
WHATSAPP_TEMPLATE_BODY_PARAMS=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JobWatch <no-reply@jobwatch.local>"
